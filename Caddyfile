{
#	admin off
	auto_https off
}
# caddy reload --config Caddyfile
:8080 {
	root * site
	encode zstd gzip

	header {
#		?Cache-Control "public, max-age=300"
		X-Content-Type-Options nosniff
		-Server
	}
	# /health/api1	Express API 1
	handle /health/api1 {
		reverse_proxy localhost:3001 {
			rewrite /health
		}
	}

	handle /api/tasks* {
		reverse_proxy localhost:3001
	}

	# /health/api2	Express API 2
	handle /health/api2 {
		reverse_proxy localhost:3002 {
			rewrite /health
		}
	}
	handle /api/manage/tasks* {
		reverse_proxy localhost:3002
	}

	# / статика
	handle {
		file_server
	}
}
